# CYMONIC AI Backend Environment Variables
# Provide either OpenAI or Groq API Key

# Option 1: Use OpenAI
# MODEL_NAME=gpt-4o-mini # Default is gpt-4o-mini

# Option 2: Use Groq (Fast Inference)
 GROQ_API_KEY=your_groq_api_key_here
# MODEL_NAME=llama-3.3-70b-versatile # Default is llama-3.3-70b-versatile
